{
  "name": "xbp-monitoring-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir dashboard run dev",
    "build": "pnpm --dir dashboard run build",
    "lint": "pnpm --dir dashboard run lint",
    "typecheck": "pnpm --dir dashboard run typecheck",
    "verify": "pnpm run typecheck && cargo fmt --all -- --check && cargo clippy --all-targets --all-features && cargo test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:config": "docker compose -f docker-compose.yml -f docker-compose.override.yml config",
    "dashboard:dev": "pnpm --dir dashboard run dev",
    "dashboard:build": "pnpm --dir dashboard run build",
    "dashboard:lint": "pnpm --dir dashboard run lint",
    "dashboard:typecheck": "pnpm --dir dashboard run typecheck"
  }
}
